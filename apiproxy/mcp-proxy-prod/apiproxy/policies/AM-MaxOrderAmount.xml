<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Publishes the per-operation `maxOrderAmount` custom attribute declared on the
  biscuit-coffee-agent API Product so that downstream policies can enforce it.

  WHY IT LIVES HERE
  Product / operation attributes only materialise as flow variables inside the
  proxy that ran VerifyAPIKey. mcp-proxy-prod is the only proxy that does that
  (Biscuit-Coffee-Shop authenticates with a Keycloak JWT and has no
  VerifyAPIKey policy), so the value has to be read here and forwarded on the
  wire as a header.

  WHY THE TEMPLATE CONCATENATES TWO VARIABLES
  Exactly one of the two VerifyAPIKey policies executes per request:
    VA-VerifyKey         - 3-legged OAuth flow (Authorization header present)
    VA-VerifyKey-Header  - direct x-api-key flow
  The one that did not run leaves its variable unresolved, which renders as an
  empty string, so the concatenation always yields the single real value.

  For any tool other than placeOrder the attribute is undefined and the header
  is emitted empty; Biscuit-Coffee-Shop only reads it on POST /orders.
-->
<AssignMessage continueOnError="false" enabled="true" name="AM-MaxOrderAmount">
  <DisplayName>AM-MaxOrderAmount</DisplayName>
  <AssignVariable>
    <Name>maxorder.amount</Name>
    <Template>{verifyapikey.VA-VerifyKey.apiproduct.operation.payload.attributes.maxOrderAmount}{verifyapikey.VA-VerifyKey-Header.apiproduct.operation.payload.attributes.maxOrderAmount}</Template>
  </AssignVariable>
  <!-- Human-in-the-loop: orders at or above this total need approval. Same
       two-variable trick as above; empty when the attribute is not set, in which
       case Biscuit-Coffee-Shop uses its own defaultApprovalThreshold. -->
  <AssignVariable>
    <Name>maxorder.approval_threshold</Name>
    <Template>{verifyapikey.VA-VerifyKey.apiproduct.operation.payload.attributes.approvalThreshold}{verifyapikey.VA-VerifyKey-Header.apiproduct.operation.payload.attributes.approvalThreshold}</Template>
  </AssignVariable>
  <Set>
    <Headers>
      <Header name="X-Max-Order-Amount">{maxorder.amount}</Header>
      <Header name="X-Approval-Threshold">{maxorder.approval_threshold}</Header>
    </Headers>
  </Set>
  <AssignTo createNew="false" transport="http" type="request"/>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
