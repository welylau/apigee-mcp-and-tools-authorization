<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Guarantees `jsonrpc.id` always resolves to something JSON-valid.

  Takes the id captured by EV-JsonRpcId when present, otherwise falls back to 0.
  Without this, an unresolved variable would render RF-Quota-Exceeded's payload
  as `"id": ,` - malformed JSON that the MCP client cannot parse, which would
  hang the tool call rather than return the quota message.
-->
<AssignMessage continueOnError="true" enabled="true" name="AM-JsonRpcIdDefault">
  <DisplayName>AM-JsonRpcIdDefault</DisplayName>
  <AssignVariable>
    <Name>jsonrpc.id</Name>
    <Value>0</Value>
    <Ref>mcpreq.id</Ref>
  </AssignVariable>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
