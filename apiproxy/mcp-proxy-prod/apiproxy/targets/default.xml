<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
  <HTTPTargetConnection>
    <Properties>
      <Property name="success.codes">1xx,2xx,3xx,4xx</Property>
    </Properties>
    <URL>https://@GCP_PROJECT_ID@.mcp.apigee.internal/mcp</URL>
  </HTTPTargetConnection>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>AM-Set200ForMCP</Name>
        <Condition>(response.status.code = 403) and (response.content ~~ ".*jsonrpc.*")</Condition>
      </Step>
    </Response>
  </PostFlow>
</TargetEndpoint>
