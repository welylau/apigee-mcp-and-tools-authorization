<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="2" name="mcp-proxy-prod">
  <DisplayName>mcp-proxy-prod</DisplayName>
  <Description>Production Apigee MCP Server</Description>
  <BasePaths>/mcp</BasePaths>
  <BasePaths>/.well-known/oauth-protected-resource/mcp</BasePaths>
  <Policies>
    <Policy>CORS-Allow</Policy>
    <Policy>JS-JsonRpcId</Policy>
    <Policy>PP-ParseMCPTools</Policy>
    <Policy>JWT-VerifyToken</Policy>
    <Policy>RF-Guest-Key-Not-Allowed</Policy>
    <Policy>AM-Fault-McpUnauthorized</Policy>
    <Policy>VA-VerifyKey</Policy>
    <Policy>VA-VerifyKey-Header</Policy>
    <Policy>AM-Set200ForMCP</Policy>
    <Policy>QU-ProductQuota</Policy>
    <Policy>QU-ProductQuota-Header</Policy>
    <Policy>RF-Quota-Exceeded</Policy>
    <!-- Consumer / end-user audit logging -->
    <Policy>EV-McpToolCall</Policy>
    <Policy>AM-AuditConsumerContext</Policy>
    <Policy>AM-AuditCorrelation</Policy>
    <Policy>AE-AuditApp</Policy>
    <Policy>AE-AuditProduct</Policy>
    <Policy>JS-AuditAttributes</Policy>
    <Policy>ML-AuditQuotaViolation</Policy>
  </Policies>
  <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
    <ProxyEndpoint>oauth-prm-endpoint</ProxyEndpoint>
  </ProxyEndpoints>
  <Resources>
    <Resource>oas://openapi.yaml</Resource>
    <Resource>jsc://auditAttributes.js</Resource>
    <Resource>jsc://jsonRpcId.js</Resource>
    <Resource>properties://idp-config.properties</Resource>
  </Resources>
  <TargetEndpoints>
    <TargetEndpoint>default</TargetEndpoint>
    <TargetEndpoint>oauth-prm-endpoint</TargetEndpoint>
  </TargetEndpoints>
</APIProxy>
