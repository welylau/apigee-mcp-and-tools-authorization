<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
  <Description>Biscuit Coffee Shop Cloud Run Backend</Description>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-SetBackendHeaders</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <HTTPTargetConnection>
    <Authentication>
      <GoogleIDToken>
        <Audience>https://biscuit-coffee-backend-YOUR_GCP_PROJECT_NUMBER.asia-southeast1.run.app</Audience>
      </GoogleIDToken>
    </Authentication>
    <URL>https://biscuit-coffee-backend-YOUR_GCP_PROJECT_NUMBER.asia-southeast1.run.app</URL>
  </HTTPTargetConnection>
</TargetEndpoint>
