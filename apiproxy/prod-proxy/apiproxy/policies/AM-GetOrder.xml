<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="AM-GetOrder">
  <Set>
    <Payload contentType="application/json">{
    "order_id": "{orderId}",
    "email": "{jwt.JWT-VerifyToken.claim.email:customer@example.com}",
    "name": "{jwt.JWT-VerifyToken.claim.name:David}",
    "loyalty_id": "{loyalty_id:L-12345}",
    "items":
    [
        {
            "item_id": "item-1",
            "quantity": 1
        }
    ],
    "status": "IN_PROGRESS",
    "eta_minutes": "{xeger( '[5-9]{1}' )}",
    "total_amount": 3.75
}</Payload>
    <StatusCode>200</StatusCode>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
