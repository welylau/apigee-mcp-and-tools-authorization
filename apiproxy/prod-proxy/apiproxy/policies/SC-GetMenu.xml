<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Fetches the live menu (with prices) from the Cloud Run backend on a cache miss.

  Uses the same GoogleIDToken authentication as targets/default.xml, because the
  backend is a private Cloud Run service.

  continueOnError is true so that a failed fetch reaches checkOrderValue.js
  instead of a generic 500. The script only accepts a 200 with a non-empty
  priced menu; anything else sets order.pricing_unavailable and the flow
  returns RF-Pricing-Unavailable (503). An order is never priced with
  fallback prices, so a backend outage cannot be used to slip past the cap.
-->
<ServiceCallout continueOnError="true" enabled="true" name="SC-GetMenu">
  <DisplayName>SC-GetMenu</DisplayName>
  <Request clearPayload="true" variable="menuRequest">
    <Set>
      <Verb>GET</Verb>
      <Path>/menu</Path>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  </Request>
  <Response>menuResponse</Response>
  <Timeout>5000</Timeout>
  <HTTPTargetConnection>
    <Authentication>
      <GoogleIDToken>
        <Audience>https://biscuit-coffee-backend-YOUR_GCP_PROJECT_NUMBER.asia-southeast1.run.app</Audience>
      </GoogleIDToken>
    </Authentication>
    <URL>https://biscuit-coffee-backend-YOUR_GCP_PROJECT_NUMBER.asia-southeast1.run.app</URL>
  </HTTPTargetConnection>
</ServiceCallout>
