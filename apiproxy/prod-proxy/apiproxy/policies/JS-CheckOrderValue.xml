<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Runs checkOrderValue.js to price the order and decide whether it breaches the cap.

  THE LIMIT IS NOT CONFIGURED HERE.
  It lives on the API Product that the caller's Keycloak client is bound to, as
  the `maxOrderAmount` / `approvalThreshold` custom attributes
  (config/agent-product-ops.json). This proxy resolves that product from the
  VERIFIED JWT azp and reads it with AccessEntity (JS-ResolveProduct,
  AE-ApiProduct, JS-ProductAttrs, cached 60s); inbound policy headers are
  stripped and never read.

  defaultMaxOrderAmount / defaultApprovalThreshold apply ONLY when the product
  does not carry the attribute. They are a fail-safe, not the knob you turn to
  change the policy.

  defaultItemPrice mirrors the backend's fallback for unrecognised item ids
  (coffee-shop-backend/main.py), keeping the two totals in agreement. It is
  never used for a whole menu: if no menu is available the order gets a 503
  (RF-Pricing-Unavailable).
-->
<Javascript continueOnError="false" enabled="true" timeLimit="200" name="JS-CheckOrderValue">
  <DisplayName>JS-CheckOrderValue</DisplayName>
  <Properties>
    <Property name="defaultMaxOrderAmount">100</Property>
    <!-- Orders at or above this total (and below the cap) need staff approval.
         Like defaultMaxOrderAmount, only used when the product has no
         approvalThreshold attribute. -->
    <Property name="defaultApprovalThreshold">50</Property>
    <Property name="defaultItemPrice">3.50</Property>
  </Properties>
  <ResourceURL>jsc://checkOrderValue.js</ResourceURL>
</Javascript>
