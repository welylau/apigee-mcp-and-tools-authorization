<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Runs checkOrderValue.js to price the order and decide whether it breaches the cap.

  THE LIMIT IS NOT CONFIGURED HERE ANY MORE.
  It lives on the biscuit-coffee-agent API Product, as a `maxOrderAmount` custom
  attribute on the tools/call/placeOrder operation (config/agent-product-ops.json),
  right next to that operation's quota. mcp-proxy-prod reads it after VerifyAPIKey
  and forwards it as the X-Max-Order-Amount header, which the script prefers.

  defaultMaxOrderAmount applies ONLY when that header is absent or unusable -
  i.e. a direct REST caller that bypassed the MCP server, or a misconfigured
  product. It is a fail-safe, not the knob you turn to change the policy.

  defaultItemPrice mirrors the backend's fallback for unrecognised item ids
  (coffee-shop-backend/main.py), keeping the two totals in agreement.
-->
<Javascript continueOnError="false" enabled="true" timeLimit="200" name="JS-CheckOrderValue">
  <DisplayName>JS-CheckOrderValue</DisplayName>
  <Properties>
    <Property name="defaultMaxOrderAmount">100</Property>
    <Property name="defaultItemPrice">3.50</Property>
  </Properties>
  <ResourceURL>jsc://checkOrderValue.js</ResourceURL>
</Javascript>
