<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Caches the menu price list after a cache miss so subsequent orders are priced
  without a backend call. Only runs when checkOrderValue.js set
  menu.cacheable=true, i.e. SC-GetMenu returned 200 with a non-empty priced
  menu, so an error body is never cached.

  5 minutes is a deliberate compromise: long enough that the callout is rare on a
  busy shop. A manager's price change takes effect immediately anyway, because
  IC-MenuCache drops the entry on a successful updateMenuItem.
-->
<PopulateCache continueOnError="true" enabled="true" name="PC-MenuCache">
  <DisplayName>PC-MenuCache</DisplayName>
  <CacheKey>
    <KeyFragment>biscuit-menu-prices</KeyFragment>
  </CacheKey>
  <Scope>Application</Scope>
  <Source>menu.json</Source>
  <ExpirySettings>
    <TimeoutInSec>300</TimeoutInSec>
  </ExpirySettings>
</PopulateCache>
