<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <!-- Generic error bodies. RaiseFault refusals (400/403/404/422/429/503)
       keep their own messages; only unplanned faults are rewritten so that no
       policy names, JWT details or backend bodies leak to the caller. -->
  <FaultRules>
    <!-- Any VerifyJWT failure (missing, expired, bad signature, wrong
         issuer/audience, ID token) -> one generic 401. -->
    <FaultRule name="jwt-invalid">
      <Step>
        <Name>AM-Fault-Unauthorized</Name>
      </Step>
      <Condition>(JWT.failed = true) and (gwfault.handled != "true")</Condition>
    </FaultRule>
    <!-- The cancelOrder ownership pre-flight could not reach the backend:
         answer with the same 404 as "not found" / "not yours". -->
    <FaultRule name="ownership-lookup-failed">
      <Step>
        <Name>AM-Fault-OrderNotFound</Name>
      </Step>
      <Condition>(servicecallout.SC-GetOrderOwner.failed = true) and (JWT.failed != true) and (gwfault.handled != "true")</Condition>
    </FaultRule>
  </FaultRules>
  <DefaultFaultRule name="default-fault">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>AM-Fault-Generic</Name>
      <Condition>(gwfault.handled != "true") and (fault.name != "RaiseFault") and (JWT.failed != true) and (servicecallout.SC-GetOrderOwner.failed != true)</Condition>
    </Step>
  </DefaultFaultRule>
  <PreFlow name="PreFlow">
    <Request>
      <!-- Never trust policy headers from the caller. Cap, threshold and the
           ownership toggle are resolved below from the VERIFIED token. -->
      <Step>
        <Name>AM-StripInboundPolicyHeaders</Name>
      </Step>
      <!-- Only the three exact public paths skip the JWT check. Anchored so that
           e.g. /staff/store/hours (manager only) is NOT treated as public. -->
      <Step>
        <Name>JWT-VerifyToken</Name>
        <Condition>not (proxy.pathsuffix ~~ "^/(location|hours|menu)/?$")</Condition>
      </Step>
      <!-- Which API Product governs this caller? Chosen from the verified azp
           claim via the azp-products property set. Unknown client = 403. -->
      <Step>
        <Name>JS-ResolveProduct</Name>
        <Condition>jwt.JWT-VerifyToken.valid = true</Condition>
      </Step>
      <Step>
        <Name>RF-Client-Not-Allowed</Name>
        <Condition>(jwt.JWT-VerifyToken.valid = true) and (product.known != "true")</Condition>
      </Step>
      <!-- Per-user burst protection (30/min per JWT sub) on every authenticated flow. -->
      <Step>
        <Name>SA-PerUser</Name>
        <Condition>jwt.JWT-VerifyToken.valid = true</Condition>
      </Step>
      <Step>
        <Name>RF-Too-Many-Requests</Name>
        <Condition>(jwt.JWT-VerifyToken.valid = true) and (ratelimit.SA-PerUser.failed = true)</Condition>
      </Step>
      <!-- Product attributes (maxOrderAmount, approvalThreshold,
           enforceOrderOwnership), read by this proxy and cached 60s. -->
      <Step>
        <Name>LC-ProductAttrs</Name>
        <Condition>jwt.JWT-VerifyToken.valid = true</Condition>
      </Step>
      <Step>
        <Name>AE-ApiProduct</Name>
        <Condition>(jwt.JWT-VerifyToken.valid = true) and (lookupcache.LC-ProductAttrs.cachehit != true)</Condition>
      </Step>
      <Step>
        <Name>JS-ProductAttrs</Name>
        <Condition>jwt.JWT-VerifyToken.valid = true</Condition>
      </Step>
      <Step>
        <Name>RF-Product-Unavailable</Name>
        <Condition>(jwt.JWT-VerifyToken.valid = true) and (productattrs.ok != "true")</Condition>
      </Step>
      <Step>
        <Name>PC-ProductAttrs</Name>
        <Condition>(jwt.JWT-VerifyToken.valid = true) and (productattrs.cacheable = "true")</Condition>
      </Step>
      <!-- AUDIT: verified end-user identity + role from the Keycloak JWT. -->
      <Step>
        <Name>AM-AuditEndUser</Name>
        <Condition>jwt.JWT-VerifyToken.valid = true</Condition>
      </Step>
      <Step>
        <Name>AM-AuditRoleCustomer</Name>
        <Condition>(jwt.JWT-VerifyToken.valid = true) and (jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_customer\b.*")</Condition>
      </Step>
      <Step>
        <Name>AM-AuditRoleStaff</Name>
        <Condition>(jwt.JWT-VerifyToken.valid = true) and (jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_staff\b.*")</Condition>
      </Step>
      <Step>
        <Name>AM-AuditRoleManager</Name>
        <Condition>(jwt.JWT-VerifyToken.valid = true) and (jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
      </Step>
      <Step>
        <Name>EV-GetId</Name>
      </Step>
      <Step>
        <Name>JS-GetFilter</Name>
      </Step>
      <!-- ?filter= is allow-listed (email, name, loyalty_id, status). -->
      <Step>
        <Name>RF-Invalid-Filter</Name>
        <Condition>orderfilter.invalid = "true"</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <!-- AUDIT: runs after the response is sent (no added latency), including on
       fault paths. Writes to Cloud Logging log 'apigee-consumer-audit'. -->
  <PostClientFlow name="PostClientFlow">
    <Response>
      <Step>
        <Name>ML-AuditLargeOrder</Name>
        <Condition>order.exceeds_limit = "true"</Condition>
      </Step>
      <Step>
        <Name>ML-AuditJwtAccess</Name>
        <Condition>jwt.JWT-VerifyToken.valid = true</Condition>
      </Step>
      <!-- Human-in-the-loop audit: the order was saved as PENDING_APPROVAL and
           now waits for a staff decision in the Staff app. -->
      <Step>
        <Name>ML-AuditApprovalRequired</Name>
        <Condition>(order.requires_approval = "true") and (response.status.code = 200)</Condition>
      </Step>
    </Response>
  </PostClientFlow>
  <Flows>
    <Flow name="getStoreLocation">
      <Description>Get store address location</Description>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/location") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="listEmployees">
      <Description>List all employees</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/employees") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="signUpLoyalty">
      <Description>Sign up for loyalty rewards</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_customer\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/loyalty/signup") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="getRewardBalance">
      <Description>Get user reward balance</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_customer\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/loyalty/balance") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="getHoursOfOperation">
      <Description>Get hours of operation</Description>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/hours") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="getMenu">
      <Description>Get coffee shop menu</Description>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/menu") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="listOrders">
      <Description>List all orders</Description>
      <!-- Pin the query to the caller.
           The backend applies X-User-Email only as the LAST branch of an elif
           chain, so a caller-supplied ?filter= / ?email= / ?name= /
           ?loyalty_id= matches earlier and overrides identity entirely. The
           constraint therefore has to be applied here, by removing those
           parameters and writing back one the gateway controls.

           Managers are exempt, so they keep the cross-customer view. -->
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_customer\b.*") and !(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
        <Step>
          <Name>JS-OwnershipFlags</Name>
        </Step>
        <Step>
          <Condition>order.pin_filter = "true"</Condition>
          <Name>AM-PinOrderFilter</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/orders") and (request.verb = "GET")</Condition>
    </Flow>

    <Flow name="placeOrder">
      <Description>Place a new order</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_customer\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
        <!-- Direct REST callers get their own per-user order quota (5/min),
             looser than the MCP product's 3/min so MCP's 429 is seen first. -->
        <Step>
          <Name>QU-PlaceOrderPerUser</Name>
        </Step>
        <Step>
          <Condition>ratelimit.QU-PlaceOrderPerUser.failed = true</Condition>
          <Name>RF-Order-Rate-Limited</Name>
        </Step>
        <!-- Maximum order value, enforced at the gateway.
             The request body carries no prices, so we price it here from the
             same menu the backend uses (cached), then reject before the target
             is called - meaning an over-limit order is never written to
             Firestore. Only reached by biscuit_coffee_customer, since the scope
             check above raises first. -->
        <Step>
          <Name>LC-MenuCache</Name>
        </Step>
        <Step>
          <Condition>lookupcache.LC-MenuCache.cachehit = false</Condition>
          <Name>SC-GetMenu</Name>
        </Step>
        <Step>
          <Name>JS-CheckOrderValue</Name>
        </Step>
        <!-- No trustworthy menu (cache empty and callout failed / empty):
             refuse rather than price with fallback prices. -->
        <Step>
          <Condition>order.pricing_unavailable = "true"</Condition>
          <Name>RF-Pricing-Unavailable</Name>
        </Step>
        <Step>
          <Condition>menu.cacheable = "true"</Condition>
          <Name>PC-MenuCache</Name>
        </Step>
        <!-- AUDIT: generic custom-attribute enumeration for the audit record,
             only when the order is about to be rejected. All continueOnError,
             so the 422 is unaffected. The app is keyed by the VERIFIED azp. -->
        <Step>
          <Condition>order.exceeds_limit = "true"</Condition>
          <Name>AE-AuditApp</Name>
        </Step>
        <Step>
          <Condition>order.exceeds_limit = "true"</Condition>
          <Name>AE-AuditDeveloper</Name>
        </Step>
        <Step>
          <Condition>order.exceeds_limit = "true"</Condition>
          <Name>JS-AuditPrepare</Name>
        </Step>
        <Step>
          <Condition>order.exceeds_limit = "true"</Condition>
          <Name>AE-AuditProduct</Name>
        </Step>
        <Step>
          <Condition>order.exceeds_limit = "true"</Condition>
          <Name>JS-AuditAttributes</Name>
        </Step>
        <Step>
          <Condition>order.exceeds_limit = "true"</Condition>
          <Name>RF-Order-Limit-Exceeded</Name>
        </Step>
      </Request>
      <Response>
        <!-- Tell the customer what the order cost and what its ID is.
             The backend supplies the figures; the sentence itself is composed
             here so the gateway owns the customer-facing wording, exactly as it
             does for the order-limit and quota refusals.
             Gated on 200 so failure responses pass through untouched. -->
        <Step>
          <Condition>response.status.code = 200</Condition>
          <Name>EV-OrderResult</Name>
        </Step>
        <Step>
          <Condition>response.status.code = 200</Condition>
          <Name>JS-FormatOrderConfirmation</Name>
        </Step>
        <Step>
          <Condition>(response.status.code = 200) and (order.confirmation_ok = "true")</Condition>
          <Name>AM-OrderConfirmation</Name>
        </Step>
        <!-- Human-in-the-loop: an order between approvalThreshold and the cap
             was saved as PENDING_APPROVAL (AM-OrderPendingApproval in the
             target PreFlow). Nothing else happens here: staff see it on the
             Staff app orders board and approve/reject it with decideOrder. -->
      </Response>
      <Condition>(proxy.pathsuffix MatchesPath "/orders") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="getOrder">
      <Description>Retrieve a specific order</Description>
      <!-- Object-level authorisation, checked on the way OUT.
           A read is non-destructive, so the target call is itself the
           ownership lookup and the check costs no extra backend call. If it
           fails, the response is discarded and replaced by RF-Order-Not-Found,
           so nothing leaks. Contrast cancelOrder below, which cannot do this. -->
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_customer\b.*") and !(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
        <Step>
          <Name>JS-OwnershipFlags</Name>
        </Step>
      </Request>
      <Response>
        <Step>
          <Condition>order.needs_lookup = "true"</Condition>
          <Name>JS-OwnershipResponse</Name>
        </Step>
        <Step>
          <Condition>order.ownership_ok = "false"</Condition>
          <Name>RF-Order-Not-Found</Name>
        </Step>
      </Response>
      <Condition>(proxy.pathsuffix MatchesPath "/orders/{order_id}") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="cancelOrder">
      <Description>Cancel an existing order</Description>
      <!-- Object-level authorisation, checked on the way IN.
           You cannot un-delete, so ownership has to be established before the
           target is called. SC-GetOrderOwner fetches the order first and
           JS-OwnershipLookup decides; an order that is not yours is refused
           without the backend ever seeing the DELETE.

           JS-OwnershipFlags runs first so that managers and the disabled state
           skip the callout entirely rather than paying for a lookup whose
           result they would ignore. It also seeds ownership_ok = "false", so
           if the callout or the lookup step is ever skipped the RaiseFault
           still fires - the safe state is the default. -->
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_customer\b.*") and !(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
        <Step>
          <Name>JS-OwnershipFlags</Name>
        </Step>
        <Step>
          <Condition>order.needs_lookup = "true"</Condition>
          <Name>SC-GetOrderOwner</Name>
        </Step>
        <Step>
          <Condition>order.needs_lookup = "true"</Condition>
          <Name>JS-OwnershipLookup</Name>
        </Step>
        <Step>
          <Condition>order.ownership_ok = "false"</Condition>
          <Name>RF-Order-Not-Found</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/orders/{order_id}") and (request.verb = "DELETE")</Condition>
    </Flow>
    <!-- ================= Staff app (/staff/*) =================
         Staff operations need biscuit_coffee_staff OR biscuit_coffee_manager;
         employee, store and stats operations need biscuit_coffee_manager.
         These flows deliberately have NO ownership policies (JS-OwnershipFlags,
         AM-PinOrderFilter, SC-GetOrderOwner): staff see every customer's
         orders. The backend repeats the scope checks from X-User-Scope. -->
    <Flow name="listAllOrders">
      <Description>Staff: list all customers' orders</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_staff\b.*") and !(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/staff/orders") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="getAnyOrder">
      <Description>Staff: view any order</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_staff\b.*") and !(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/staff/orders/*") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="updateOrderStatus">
      <Description>Staff: update order progress</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_staff\b.*") and !(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/staff/orders/*/status") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="decideOrder">
      <Description>Staff: approve or reject an order waiting for approval</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_staff\b.*") and !(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/staff/orders/*/decision") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="getEmployee">
      <Description>Manager: employee details</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/staff/employees/*") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="updateStoreHours">
      <Description>Manager: change opening hours for a day</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/staff/store/hours") and (request.verb = "PUT")</Condition>
    </Flow>
    <Flow name="updateMenuItem">
      <Description>Manager: change a menu item's price, name or sold-out flag</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response>
        <!-- New price takes effect on the very next order. -->
        <Step>
          <Condition>response.status.code = 200</Condition>
          <Name>IC-MenuCache</Name>
        </Step>
      </Response>
      <Condition>(proxy.pathsuffix MatchesPath "/staff/menu/*") and (request.verb = "PATCH")</Condition>
    </Flow>
    <Flow name="getSalesStats">
      <Description>Manager: sales statistics</Description>
      <Request>
        <Step>
          <Condition>!(jwt.JWT-VerifyToken.claim.scope ~~ ".*\bbiscuit_coffee_manager\b.*")</Condition>
          <Name>RF-Invalid-Scope</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/staff/stats") and (request.verb = "GET")</Condition>
    </Flow>
    <!-- Catch-all: MUST stay the last flow. Anything not matched above is
         refused here and never reaches the target. -->
    <Flow name="unknownResource">
      <Description>Refuse any path or verb not declared above</Description>
      <Request>
        <Step>
          <Name>RF-Unknown-Resource</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>

  </Flows>
  <HTTPProxyConnection>
    <BasePath>/biscuit-coffee</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
